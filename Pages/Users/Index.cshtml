@page
@model PrintShop3D.Pages.Users.IndexModel
@{ ViewData["Title"] = "Users"; }
<h3 class="mb-3">User Management</h3>
<div class="row"><div class="col-md-5"><div class="card mb-4"><div class="card-header">Create User</div><div class="card-body"><form method="post" asp-page-handler="Create" class="row g-2"><div class="col-12"><label class="form-label">Username</label><input asp-for="NewUser.Username" class="form-control" /></div><div class="col-12"><label class="form-label">Temporary Password</label><input asp-for="NewUser.Password" type="password" class="form-control" /></div><div class="col-6"><label class="form-label">Role</label><select asp-for="NewUser.Role" class="form-select">@foreach (var r in DomainConstants.UserRoles) { <option value="@r">@r</option> }</select></div><div class="col-6"><label class="form-label">Employee</label><select asp-for="NewUser.EmployeeId" class="form-select"><option value="">-- none --</option>@foreach (var e in Model.Employees) { <option value="@e.EmployeeId">@e.FullName</option> }</select></div><div class="col-12"><button class="btn btn-primary">Create User</button></div></form></div></div></div>
<div class="col-md-7"><div class="card"><div class="card-header">Existing Users</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>User</th><th>Role</th><th>Employee</th><th>Status</th><th>Manage</th></tr></thead><tbody>
@foreach (var u in Model.Users)
{
<tr><td>@u.Username</td><td>@u.Role</td><td>@u.Employee?.FullName</td><td><span class="badge @(u.IsActive ? "text-bg-success" : "text-bg-secondary")">@(u.IsActive ? "ACTIVE" : "INACTIVE")</span></td><td><details><summary>Edit</summary><form method="post" asp-page-handler="Edit" class="mt-2"><input type="hidden" name="EditUser.UserId" value="@u.UserId" /><div class="mb-2"><select name="EditUser.Role" class="form-select form-select-sm">@foreach (var r in DomainConstants.UserRoles) { <option value="@r" selected="@(u.Role == r )">@r</option> }</select></div><div class="mb-2"><select name="EditUser.EmployeeId" class="form-select form-select-sm"><option value="">-- none --</option>@foreach (var e in Model.Employees) { <option value="@e.EmployeeId" selected="@(u.EmployeeId == e.EmployeeId )">@e.FullName</option> }</select></div><div class="mb-2"><input name="EditUser.NewPassword" type="password" class="form-control form-control-sm" placeholder="New password (optional)" /></div><div class="form-check mb-2"><input name="EditUser.IsActive" value="true" type="checkbox" class="form-check-input" @(u.IsActive ? "checked" : null) /><label class="form-check-label">Active</label></div><button class="btn btn-sm btn-primary">Save</button></form></details></td></tr>
}
</tbody></table></div></div></div></div>
