@page
@model PrintShop3D.Pages.Files.CreateModel
@{ ViewData["Title"] = "Add Design Files"; }
<h3>Add Design Files - @Model.ItemLabel</h3>
<p class="text-muted">Upload one or more supported 3D design files, or register one external shared-drive/NAS path.</p>
<form method="post" asp-page="Create" enctype="multipart/form-data" class="row g-3">
    <input type="hidden" asp-for="OrderItemId" />

    <div class="col-12">
        <label class="form-label">Upload design files</label>
        <input asp-for="Uploads" type="file" class="form-control" accept=".stl,.3mf,.obj,.step,.stp" multiple />
        <div class="form-text">Multiple files are supported. Maximum 100 MB per file and 300 MB total per upload.</div>
    </div>

    <div class="col-12"><div class="text-muted small">OR</div></div>

    <div class="col-md-6">
        <label class="form-label">External file path</label>
        <input asp-for="ExternalFilePath" class="form-control" placeholder="\\server\share\designs\..." />
    </div>
    <div class="col-md-3">
        <label class="form-label">File Name</label>
        <input asp-for="FileName" class="form-control" placeholder="Optional" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Extension</label>
        <input asp-for="FileExtension" class="form-control" placeholder=".stl" />
    </div>
    <div class="col-12">
        <label class="form-label">Notes</label>
        <input asp-for="Notes" class="form-control" />
    </div>
    <div class="col-12">
        <button class="btn btn-primary">Save Design File(s)</button>
        <a class="btn btn-secondary" asp-page="Index" asp-route-orderItemId="@Model.OrderItemId">Cancel</a>
    </div>
</form>
