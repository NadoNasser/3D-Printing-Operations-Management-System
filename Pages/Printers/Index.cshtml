@page
@model PrintShop3D.Pages.Printers.IndexModel
@using PrintShop3D.Common
@{ ViewData["Title"] = "Printers"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h3>Printers</h3><div class="text-muted">BUSY is calculated from active schedules.</div></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-3"><select name="statusFilter" class="form-select"><option value="">All statuses</option>@foreach (var s in DomainConstants.PrinterStatuses) { <option value="@s" selected="@(Model.StatusFilter == s )">@s</option> }</select></div><div class="col-auto"><button class="btn btn-outline-primary">Filter</button><a class="btn btn-outline-secondary" asp-page="Index">Clear</a></div></form>
@if (!Model.Printers.Any()) { <div class="alert alert-info">No printers match the selected filter.</div> }
else
{
<table class="table bg-white align-middle"><thead><tr><th>Code</th><th>Brand/Model</th><th>Technology</th><th>Status</th><th>Quality</th><th>Best Materials</th><th></th></tr></thead><tbody>
@foreach (var p in Model.Printers)
{
<tr><td>@p.PrinterCode</td><td>@p.Brand @p.Model</td><td>@p.Technology</td><td><span class="badge @Model.BadgeClass(p.Status)">@p.Status</span></td><td>@p.PrintQuality</td><td>@foreach (var m in Model.ParsedRatings(p)) { <span class="badge text-bg-light border me-1">@m.Material (@m.Rating)</span> }</td><td class="d-flex gap-2"><form method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@p.PrinterId" /><input type="hidden" name="currentFilter" value="@Model.StatusFilter" /><select name="status" class="form-select form-select-sm">@foreach (var s in Model.ManualStatuses) { <option value="@s" selected="@(s == p.Status )">@s</option> }</select><button class="btn btn-sm btn-outline-primary">Update</button></form><a class="btn btn-sm btn-outline-secondary" asp-page="Profile" asp-route-id="@p.PrinterId">Profile</a><a class="btn btn-sm btn-outline-warning" asp-page="Maintenance" asp-route-id="@p.PrinterId">Maintenance</a></td></tr>
}
</tbody></table>
}
<div class="card mt-4"><div class="card-header">Suggest a printer by material</div><div class="card-body"><form method="get" class="row g-2"><div class="col-auto"><select name="material" class="form-select">@foreach (var m in DomainConstants.PrintMaterialTypes) { <option value="@m" selected="@(m == Model.SuggestedFor )">@m</option> }</select></div><div class="col-auto"><button class="btn btn-outline-primary">Suggest</button></div></form>
@if (Model.Suggestions.Any()) { <table class="table mt-3 mb-0"><thead><tr><th>Printer</th><th>Brand/Model</th><th>Quality</th><th>Rating for @Model.SuggestedFor</th></tr></thead><tbody>@foreach (var s in Model.Suggestions) { <tr><td>@s.PrinterCode</td><td>@s.Brand @s.Model</td><td>@s.PrintQuality</td><td>@s.Rating</td></tr> }</tbody></table> } else if (Model.SuggestedFor != null) { <p class="text-muted mt-3 mb-0">No available printer has a rated profile for @Model.SuggestedFor yet.</p> }
</div></div>
