@page "{id:int}"
@model PrintShop3D.Pages.Printers.ProfileModel
@{ ViewData["Title"] = "Printer Profile - " + Model.Printer.PrinterCode; }
<h3>Printer Profile - @Model.Printer.PrinterCode (@Model.Printer.Brand @Model.Printer.Model)</h3>

<form method="post" asp-page="/Printers/Profile" asp-route-id="@Model.Printer.PrinterId">
    <input type="hidden" asp-for="PrinterId" />
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label class="form-label">Print Quality</label>
            <select asp-for="PrintQuality" class="form-select">
                <option value="">-- not set --</option>
                @foreach (var q in DomainConstants.PrintQualities) { <option value="@q">@q</option> }
            </select>
        </div>
    </div>

    <h5>Best materials for this printer</h5>
    <p class="text-muted">Saved as JSON and used by the "Suggest a printer by material" lookup on the Printers list.</p>
    <div id="ratings">
        @for (int i = 0; i < Model.Ratings.Count; i++)
        {
            <div class="row g-2 mb-2">
                <div class="col-md-4">
                    <select name="Ratings[@i].Material" class="form-select">
                        @foreach (var m in DomainConstants.PrintMaterialTypes)
                        {
                            <option value="@m" selected="@(m == Model.Ratings[i].Material )">@m</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <input type="number" min="1" max="5" name="Ratings[@i].Rating" value="@Model.Ratings[i].Rating" class="form-control" placeholder="Rating 1-5" />
                </div>
            </div>
        }
    </div>
    <button type="submit" asp-page-handler="AddRow" asp-route-id="@Model.Printer.PrinterId" class="btn btn-outline-secondary btn-sm mb-3">+ Add material</button>
    <div class="card mt-4 mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Maintenance</strong>
            <span class="badge @PrintShop3D.Common.WorkflowRules.StatusBadgeClass(Model.Printer.Status)">@Model.Printer.Status</span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4"><div class="text-muted small">Maintenance records</div><div class="fs-5">@Model.MaintenanceCount</div></div>
                <div class="col-md-4"><div class="text-muted small">Total maintenance cost</div><div class="fs-5">@Model.TotalMaintenanceCost.ToString("N2")</div></div>
                <div class="col-md-4"><div class="text-muted small">Latest status</div><div class="fs-5">@(Model.LatestMaintenance?.Status ?? "No records")</div></div>
            </div>
            <div class="mt-3">
                <a class="btn btn-outline-primary" asp-page="Maintenance" asp-route-id="@Model.Printer.PrinterId">View Maintenance History</a>
                <a class="btn btn-outline-secondary" asp-page="Maintenance" asp-route-id="@Model.Printer.PrinterId">+ Add Maintenance</a>
            </div>
        </div>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save Profile</button>
        <a class="btn btn-secondary" asp-page="Index">Back to Printers</a>
    </div>
</form>
