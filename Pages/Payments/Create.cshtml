@page
@model PrintShop3D.Pages.Payments.CreateModel
@{ ViewData["Title"] = "Add Payment"; }
<h3>Add Payment - Order #@Model.OrderId</h3>
<div class="alert alert-info">Remaining balance: <strong>@Model.RemainingBalance.ToString("N2")</strong></div>
<form method="post" asp-page="Create" class="row g-3">
    <input type="hidden" asp-for="OrderId" />
    <div class="col-md-3"><label class="form-label">Amount</label><input asp-for="Payment.Amount" class="form-control" min="0.01" step="0.01" max="@Model.RemainingBalance" /></div>
    <div class="col-md-3"><label class="form-label">Method</label><select asp-for="Payment.PaymentMethod" class="form-select">@foreach (var m in DomainConstants.PaymentMethods) { <option value="@m">@m</option> }</select></div>
    <div class="col-md-3"><label class="form-label">Status</label><select asp-for="Payment.PaymentStatus" class="form-select">@foreach (var s in DomainConstants.PaymentStatuses) { <option value="@s">@s</option> }</select></div>
    <div class="col-md-3"><label class="form-label">Reference</label><input asp-for="Payment.Reference" class="form-control" /></div>
    <div class="col-12"><button class="btn btn-primary" @(Model.RemainingBalance <= 0 ? "disabled" : null)>Save Payment</button><a class="btn btn-secondary" asp-page="/Orders/Details" asp-route-id="@Model.OrderId">Cancel</a></div>
</form>
