@page
@model PrintShop3D.Pages.Catalog.ProductsModel
@{ ViewData["Title"] = "Products"; }
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" asp-page="Products">Products</a></li>
    <li class="nav-item"><a class="nav-link" asp-page="Services">Services</a></li>
</ul>
<div class="row">
    <div class="col-md-7">
        <form method="get" asp-page="Products" class="row g-2 mb-3">
            <div class="col">
                <input name="search" value="@Model.Search" class="form-control" placeholder="Search products by name, category or description..." autocomplete="off" />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-primary">Search</button>
                @if (Model.Search != null) { <a class="btn btn-outline-secondary" asp-page="Products">Clear</a> }
            </div>
        </form>
        @if (!Model.ProductsList.Any())
        {
            <div class="alert alert-info">@(Model.Search != null ? $"No products match '{Model.Search}'." : "No products yet.")</div>
        }
        else
        {
        <div class="small text-muted mb-1">@Model.ProductsList.Count product(s)@(Model.Search != null ? " found" : "")</div>
        <table class="table bg-white">
            <thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Unit</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in Model.ProductsList)
            {
                <tr>
                    <td>@p.Name</td><td>@p.Category</td><td>@p.BasePrice.ToString("N2")</td><td>@p.Unit</td>
                    <td><a class="btn btn-sm btn-outline-primary" asp-page="Products" asp-page-handler="Edit" asp-route-id="@p.ProductId" asp-route-search="@Model.Search">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
        }
    </div>
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">@(Model.EditingId == null ? "New Product" : "Edit Product")</div>
            <div class="card-body">
                <form method="post" asp-page="/Catalog/Products" asp-route-search="@Model.Search">
                    <input type="hidden" asp-for="Form.ProductId" />
                    <div class="mb-2"><label class="form-label">Name</label><input asp-for="Form.Name" class="form-control" /></div>
                    <div class="mb-2"><label class="form-label">Category</label><input asp-for="Form.Category" class="form-control" /></div>
                    <div class="mb-2"><label class="form-label">Description</label><textarea asp-for="Form.Description" class="form-control"></textarea></div>
                    <div class="mb-2"><label class="form-label">Base Price</label><input asp-for="Form.BasePrice" class="form-control" /></div>
                    <div class="mb-2"><label class="form-label">Unit</label><input asp-for="Form.Unit" class="form-control" /></div>
                    <button class="btn btn-primary" type="submit">Save</button>
                    @if (Model.EditingId != null)
                    {
                        <a class="btn btn-secondary" asp-page="Products" asp-route-search="@Model.Search">Cancel</a>
                    }
                </form>
            </div>
        </div>
    </div>
</div>
