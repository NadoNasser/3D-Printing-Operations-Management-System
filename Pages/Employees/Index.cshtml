@page
@model PrintShop3D.Pages.Employees.IndexModel
@{ ViewData["Title"] = "Employees"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Employees</h3>
    <a class="btn btn-primary" asp-page="Create">+ New Employee</a>
</div>
<table class="table bg-white">
    <thead><tr><th>Code</th><th>Name</th><th>Role</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var e in Model.EmployeesList)
    {
        <tr>
            <td>@e.EmployeeCode</td><td>@e.FullName</td><td>@e.PrimaryRole</td>
            <td><span class="badge @(e.Status == "ACTIVE" ? "text-bg-success" : "text-bg-secondary")">@e.Status</span></td>
            <td><a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@e.EmployeeId">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
