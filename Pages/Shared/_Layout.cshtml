<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Print Shop 3D</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <nav class="navbar navbar-expand-xl navbar-light bg-white px-3">
         <a class="navbar-brand brand-lockup" asp-page="/Index">
            <img src="~/images/logo-full.png" alt="3D Express Cairo" class="brand-icon">
        <span class="brand-text">
        <span class="brand-name">EXPRESS</span>
        <span class="brand-sub">CAIRO</span>
        </span>
         </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-page="/Index">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Customers/Index">Customers</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Catalog/Products">Products</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Catalog/Services">Services</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Orders/Index">Orders</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/ProductionJobs/Index">Production</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Printers/Index">Printers</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Materials/Index">Inventory</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Payments/Index">Payments</a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/PurchaseOrders/Index">Purchasing</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Employees/Index">Employees</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Users/Index">Users</a></li>
                }
            </ul>
            <span class="navbar-text me-3">
                @User.Identity!.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
            </span>
            <form method="post" asp-page="/Account/Logout">
                <button class="btn btn-outline-primary btn-sm" type="submit">Logout</button>
            </form>
        </div>
    </nav>
}
<div class="container-fluid py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    <partial name="_ValidationSummaryPartial" view-data="@ViewData" />
    @RenderBody()
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
