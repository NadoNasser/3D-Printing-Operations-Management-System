@page
@model PrintShop3D.Pages.Customers.IndexModel
@{ ViewData["Title"] = "Customers"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Customers</h3>
    <a class="btn btn-primary" asp-page="Create">+ New Customer</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><input type="text" name="q" value="@Model.Query" class="form-control" placeholder="Search name, phone, code..." /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div>
</form>
<table class="table table-hover bg-white">
    <thead><tr><th>Code</th><th>Name</th><th>Phone</th><th>Company</th><th>Status</th><th>Addresses</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model.CustomersList)
    {
        <tr>
            <td>@c.CustomerCode</td><td>@c.Name</td><td>@c.Phone</td><td>@c.Company</td><td>
                @if (c.IsBlacklisted) { <span class="badge text-bg-danger">BLACKLISTED</span> } else { <span class="badge text-bg-success">ACTIVE</span> }
            </td><td>@c.Addresses.Count</td>
            <td><a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@c.CustomerId">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
